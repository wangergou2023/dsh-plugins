{
  "name": "yue2_text2music",
  "workflow": "yue2_text2music.api.json",
  "note": "文生音乐：YuE2 3B。style 描述曲风，lyrics 写带段落标记的歌词；先由 YuE2GenerateABC 生成曲式，再合成音频。",
  "knobs": {
    "style": {
      "node": "33:36",
      "input": "value",
      "kind": "string",
      "required": true,
      "label": "曲风描述"
    },
    "lyrics": {
      "node": "33:37",
      "input": "value",
      "kind": "string",
      "required": true,
      "label": "歌词"
    },
    "duration": {
      "node": "33:25",
      "input": "max_duration",
      "kind": "float",
      "min": 10,
      "max": 600,
      "step": 1,
      "default": 120,
      "label": "最长时长（秒）"
    },
    "useAbc": {
      "node": "33:31",
      "input": "value",
      "kind": "boolean",
      "default": true,
      "label": "先写曲式（ABC）",
      "note": "关掉则由 YuE2GenerateMusic 直接自由生成，速度快、结构弱"
    },
    "mode": {
      "node": "33:25",
      "input": "mode",
      "kind": "enum",
      "options": [
        "full",
        "melody"
      ],
      "default": "full",
      "label": "模式",
      "note": "full=旋律+和弦；melody=仅旋律（做翻唱用）"
    },
    "steps": {
      "node": "33:8",
      "input": "steps",
      "kind": "int",
      "min": 8,
      "max": 80,
      "default": 32,
      "label": "步数"
    },
    "cfg": {
      "node": "33:8",
      "input": "cfg",
      "kind": "float",
      "min": 1,
      "max": 10,
      "step": 0.1,
      "default": 1,
      "label": "CFG"
    },
    "seed": {
      "node": "33:34",
      "input": "seed",
      "kind": "seed",
      "label": "种子"
    },
    "format": {
      "node": "10",
      "input": "format",
      "kind": "enum",
      "options": [
        "flac",
        "mp3",
        "opus"
      ],
      "default": "flac",
      "label": "输出格式"
    },
    "quality": {
      "node": "10",
      "input": "format.quality",
      "kind": "string",
      "default": "",
      "label": "码率（mp3/opus）",
      "note": "mp3: V0/128k/320k；opus: 64k…320k；留空用默认"
    },
    "filenamePrefix": {
      "node": "10",
      "input": "filename_prefix",
      "kind": "string",
      "default": "audio/YuE2",
      "label": "输出前缀"
    }
  },
  "output": {
    "saveNode": "10",
    "class_type": "SaveAudioAdvanced",
    "field": "audio",
    "note": "从 /history 的 outputs['10'].audio[0] 取 {filename, subfolder, type}"
  }
}
